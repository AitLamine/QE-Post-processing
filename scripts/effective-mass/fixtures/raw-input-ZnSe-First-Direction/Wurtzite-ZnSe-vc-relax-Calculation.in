 &CONTROL
                 calculation = 'vc-relax',
                      outdir = './out/',
                  pseudo_dir = '/home/aitlamine/pseudo',
                      prefix = 'Bulk-ZnSe-Wurtzite-PBESOL',
                   verbosity = 'high',
 /
 &SYSTEM
                       ibrav = 4,
                   celldm(1) = 7.558904499,
                   celldm(2) = 1.0000000,
                   celldm(3) = 1.630000000,
                   celldm(4) = 0.0000000,
                   celldm(5) = 0.0000000,
                   celldm(6) = -0.5000000,
                         nat = 4,
                        ntyp = 2,
                     ecutwfc = 50,
                     ecutrho = 600,
                        nbnd = 45,
                   input_dft = 'pbesol',
                 occupations = 'fixed',
 /
 &ELECTRONS
            electron_maxstep = 999,
                    conv_thr = 1e-07,
 /
 &IONS
 /
 &CELL
 /
ATOMIC_SPECIES
   Zn      65.3800000	  Zn.pbe-dnl-rrkjus_psl.1.0.0.UPF
   Se      78.9710000     Se.pbe-dn-rrkjus_psl.1.0.0.UPF 

ATOMIC_POSITIONS crystal
   Zn       0.3333333     0.6666667     0.5000000
   Zn       0.6666667     0.3333333     0.0000000
   Se       0.6666667     0.3333333     0.3750000
   Se       0.3333333     0.6666667     0.8750000

K_POINTS automatic 
   7 7 7   0 0 0
